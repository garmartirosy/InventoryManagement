@page
@model InventoryManagement.Pages.StockTransactions.IndexModel

<h1>Stock Transactions</h1>

<form method="post">
    <input asp-for="StockTransaction.Id" type="hidden" />

    <div>
        <label asp-for="StockTransaction.ProductId"></label>
        <select asp-for="StockTransaction.ProductId">
            <option value="">-- Select a product --</option>
            @foreach (var product in Model.Products)
            {
                <option value="@product.Id">@product.Name</option>
            }
        </select>
        <span asp-validation-for="StockTransaction.ProductId"></span>
    </div>

    <div>
        <label asp-for="StockTransaction.Amount"></label>
        <input asp-for="StockTransaction.Amount" type="number" />
        <span asp-validation-for="StockTransaction.Amount"></span>
    </div>

    <div>
        <label asp-for="StockTransaction.Description"></label>
        <textarea asp-for="StockTransaction.Description"></textarea>
        <span asp-validation-for="StockTransaction.Description"></span>
    </div>

    <button type="submit">Save</button>
    <a asp-page="./Index">Clear</a>
</form>

<table>
    <thead>
        <tr>
            <th>Product</th>
            <th>Amount</th>
            <th>Description</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var stockTransaction in Model.StockTransactions)
        {
            <tr>
                <td>@stockTransaction.ProductName</td>
                <td>@stockTransaction.Amount</td>
                <td>@stockTransaction.Description</td>
                <td>
                    <a asp-page="./Index" asp-route-id="@stockTransaction.Id">Edit</a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@stockTransaction.Id">
                        <button type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
